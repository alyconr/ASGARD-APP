{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "postgres": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["uv", "run", "postgres-mcp", "--access-mode=unrestricted"],
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI_GUIASSENA}",
        "DATABASE_URI_GUIASSENA": "{env:DATABASE_URI_GUIASSENA}",
      },
    },

    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}",
      },
    },

    "codegraph": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["codegraph", "serve", "--mcp"],
    },

    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },

    "dokploy-mcp": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["cmd", "/c", "npx", "-y", "@dokploy/mcp@latest"],
      "environment": {
        "DOKPLOY_URL": "{env:DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}",
      },
    },

  },

  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "apiKey": "{env:NAN_API_KEY}",
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6",
        },
      },
    },
  },
}
