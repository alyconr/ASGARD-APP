# Plantilla de variables para docker-compose.production.yml
# Definir estas variables en la seccion Environment del servicio Compose en Dokploy.
# No commitear valores reales.

# --- nginx / acceso ---
# Puerto principal (solo necesario si se accede directo por IP; con dominio Traefik usa el puerto interno)
NGINX_HTTP_PORT=8080
# Puerto de la consola de MinIO (proxyeada por nginx con basic auth)
MINIO_CONSOLE_PORT=9001
# Host publico (dominio) usado para redirecciones de la consola MinIO
PUBLIC_HOST=localhost

# --- PostgreSQL (interno, no expuesto) ---
POSTGRES_DB=sena_guias_db
POSTGRES_USER=sena_guias
POSTGRES_PASSWORD=cambiar-este-valor

# --- MinIO (interno, no expuesto) ---
MINIO_ROOT_USER=cambiar-este-valor
MINIO_ROOT_PASSWORD=cambiar-este-valor
STORAGE_BUCKET_NAME=sena-programa-documentos

# --- Opcional: origenes CORS (con dominio propio y origen unico no suele ser necesario) ---
CORS_ALLOW_ORIGINS=

# --- Basic Auth de nginx ---
# Usuario: asgard (deploy/production/nginx.htpasswd). Cambiar la clave regenerando el hash:
#   docker run --rm httpd:alpine htpasswd -nb asgard NUEVA_CLAVE
