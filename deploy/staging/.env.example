# Plantilla de variables para docker-compose.staging.yml
# En Dokploy: definir estas variables en la seccion Environment del servicio Compose.
# No commitear valores reales.

# --- nginx / acceso ---
# Puerto principal de la app (frontend + API): http://<ip-servidor>:NGINX_HTTP_PORT
NGINX_HTTP_PORT=8080
# Puerto de la consola de MinIO (proxyeada por nginx con basic auth)
MINIO_CONSOLE_PORT=9001
# Host publico (IP o dominio) usado para redirecciones de la consola MinIO
PUBLIC_HOST=localhost

# --- PostgreSQL (interno, no expuesto) ---
POSTGRES_DB=sena_guias_db
POSTGRES_USER=sena_guias
POSTGRES_PASSWORD=cambiar-este-valor

# --- MinIO (interno, no expuesto) ---
MINIO_ROOT_USER=sena-staging-admin
MINIO_ROOT_PASSWORD=cambiar-este-valor
STORAGE_BUCKET_NAME=sena-programa-documentos

# --- Opcional: origenes CORS (por defecto los del reverse proxy) ---
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Basic Auth de nginx ---
# Usuario/clave se definen en deploy/staging/nginx.htpasswd (archivo commiteado con hash).
# Para cambiar la clave: generar un nuevo hash apr1 y reemplazar la linea del archivo.
#   Ej.: docker run --rm httpd:alpine htpasswd -nb sena NUEVA_CLAVE
# Credencial por defecto (staging): usuario "sena" (cambiar antes de usar).
