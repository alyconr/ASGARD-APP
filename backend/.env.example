APP_NAME="SENA Guia Aprendizaje API"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sena_guias_db"
ALEMBIC_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/sena_guias_db"
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Storage MinIO (En producción/staging usar credenciales seguras y no admin/admin123)
STORAGE_PROVIDER="minio"
STORAGE_BUCKET_NAME="sena-programa-documentos"
STORAGE_ENDPOINT="localhost:9000"
STORAGE_ACCESS_KEY="admin"
STORAGE_SECRET_KEY="admin123"
STORAGE_SECURE=false
STORAGE_REGION=

# Seguridad y Autenticación
# En producción/staging generar una clave secreta segura (ej. openssl rand -hex 32)
JWT_SECRET_KEY="asgard-super-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_COOKIE_NAME="asgard_refresh_token"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"
AUTH_COOKIE_DOMAIN=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

